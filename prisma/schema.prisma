generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photo {
  id           String   @id @default(cuid())
  cloudinaryId String   @unique
  src          String
  alt          String
  title        String?
  location     String?
  year         Int      @default(2025)
  mood         String[]
  camera       String?
  lens         String?
  iso          Int?
  featured     Boolean  @default(false)
  width        Int
  height       Int
  blurDataURL  String?
  order        Int      @default(0)
  categorySlug String
  category     Category @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  slug          String  @id
  title         String
  titleVi       String
  description   String
  descriptionVi String
  heroImage     String?
  heroCloudId   String?
  accentColor   String
  tone          String
  photos        Photo[]
}
